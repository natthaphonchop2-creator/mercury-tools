# Mercury Tools
MERCURY_TOOLS_EMBEDDING_MODEL=text-embedding-3-small
MERCURY_TOOLS_EMBEDDING_DIM=1536

# Remote MCP server
MERCURY_TOOLS_MCP_TRANSPORT=streamable-http
MERCURY_TOOLS_HOST=0.0.0.0
MERCURY_TOOLS_PORT=8000
MERCURY_TOOLS_MCP_PATH=/mcp
MERCURY_TOOLS_PUBLIC_BASE_URL=https://your-mercury-tools-host.example.com
MERCURY_TOOLS_HTTP_REQUIRE_AUTH=true
MERCURY_TOOLS_HTTP_BEARER_TOKEN=replace-with-a-long-random-token

# Required for Supabase-backed RAG
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for default embeddings
OPENAI_API_KEY=your-openai-api-key

# Optional local Mercury install for connector status / skill resources
MERCURY_AGENT_PATH=/path/to/mercury-agent
MERCURY_HOME=~/.mercury-agent
