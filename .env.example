# Mercury Tools hosted catalog/RAG metadata service
MERCURY_TOOLS_EMBEDDING_PROVIDER=hash
MERCURY_TOOLS_EMBEDDING_MODEL=text-embedding-3-small
MERCURY_TOOLS_EMBEDDING_DIM=1536

# Streamable HTTP MCP
MERCURY_TOOLS_MCP_TRANSPORT=streamable-http
MERCURY_TOOLS_HOST=0.0.0.0
MERCURY_TOOLS_PORT=8000
MERCURY_TOOLS_MCP_PATH=/mcp
MERCURY_TOOLS_PUBLIC_BASE_URL=https://your-mercury-tools-host.example.com
MERCURY_TOOLS_HTTP_REQUIRE_AUTH=false
MERCURY_TOOLS_HTTP_BEARER_TOKEN=
MERCURY_TOOLS_ENABLE_LEGACY_HTTP_API=false

# Exact deployment identity. Set a 40-character lowercase Git commit in deployment.
MERCURY_DEPLOYMENT_COMMIT=

# Supabase stores catalog, RAG, and audit metadata only. Never add ERP credentials.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional only when MERCURY_TOOLS_EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=your-openai-api-key
