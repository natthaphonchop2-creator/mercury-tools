# Mercury Tools hosted catalog/RAG metadata service
MERCURY_TOOLS_EMBEDDING_PROVIDER=hash
MERCURY_TOOLS_EMBEDDING_MODEL=text-embedding-3-small
MERCURY_TOOLS_EMBEDDING_DIM=1536

# Streamable HTTP MCP
MERCURY_TOOLS_MCP_TRANSPORT=streamable-http
MERCURY_TOOLS_HOST=0.0.0.0
MERCURY_TOOLS_PORT=8000
MERCURY_TOOLS_MCP_PATH=/mcp
MERCURY_TOOLS_PUBLIC_BASE_URL=https://your-mercury-tools-host.example.com
MERCURY_TOOLS_HTTP_REQUIRE_AUTH=false
MERCURY_TOOLS_HTTP_BEARER_TOKEN=
MERCURY_TOOLS_ENABLE_LEGACY_HTTP_API=false

# Optional explicit deployment identity override. Invalid nonempty values fail closed.
MERCURY_DEPLOYMENT_COMMIT=
# Render sets this native 40-character lowercase commit; used only without an override.
RENDER_GIT_COMMIT=

# Supabase stores tenant data and encrypted credential envelopes. Provider
# credential plaintext must never be placed in this file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional only when MERCURY_TOOLS_EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=your-openai-api-key

# Mercury V1 remains disabled until every required server-side value is set.
MERCURY_V1_ENABLED=false
MERCURY_CANONICAL_MCP_RESOURCE=https://mercury-tools-mcp.onrender.com/mcp
SUPABASE_AUTH_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=https://mercury-tools-mcp.onrender.com/mcp
MERCURY_VAULT_ACTIVE_KEY=
MERCURY_VAULT_ACTIVE_KEY_VERSION=
MERCURY_VAULT_PREVIOUS_KEY=
MERCURY_VAULT_PREVIOUS_KEY_VERSION=
FLOWACCOUNT_MCP_SANDBOX_URL=
FLOWACCOUNT_MCP_PRODUCTION_URL=
FLOWACCOUNT_OAUTH_SANDBOX_AUTHORIZATION_SERVER_ORIGIN=
FLOWACCOUNT_OAUTH_PRODUCTION_AUTHORIZATION_SERVER_ORIGIN=
PEAK_MCP_UAT_URL=
PEAK_MCP_PRODUCTION_URL=
MERCURY_PROVIDER_CALLBACK_BASE_URL=https://mercury-tools-mcp.onrender.com
