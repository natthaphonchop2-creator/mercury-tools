# Mercury Tools
MERCURY_TOOLS_EMBEDDING_PROVIDER=hash
MERCURY_TOOLS_EMBEDDING_MODEL=text-embedding-3-small
MERCURY_TOOLS_EMBEDDING_DIM=1536

# Remote MCP server
MERCURY_TOOLS_MCP_TRANSPORT=streamable-http
MERCURY_TOOLS_HOST=0.0.0.0
MERCURY_TOOLS_PORT=8000
MERCURY_TOOLS_MCP_PATH=/mcp
MERCURY_TOOLS_PUBLIC_BASE_URL=https://your-mercury-tools-host.example.com
MERCURY_TOOLS_HTTP_REQUIRE_AUTH=false
MERCURY_TOOLS_HTTP_BEARER_TOKEN=

# Public workspace connector vault
MERCURY_CREDENTIAL_VAULT_SECRET=replace-with-long-random-vault-secret

# Optional legacy HTTP compatibility API only
MERCURY_CONNECT_INVITE_CODE=

# Required for Supabase-backed RAG
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Only required when MERCURY_TOOLS_EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=your-openai-api-key
